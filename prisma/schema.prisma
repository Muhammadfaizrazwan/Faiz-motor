// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum MotorCondition {
  BARU
  BEKAS
}

enum MotorStatus {
  TERSEDIA
  DIPESAN
  TERJUAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// MODELS
// ============================================

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  phone     String?
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  reviews     Review[]
  savedMotors SavedMotor[]

  @@map("users")
}

model Motor {
  id          String         @id @default(cuid())
  name        String
  brand       String
  year        Int
  color       String
  condition   MotorCondition
  price       Float
  description String?
  status      MotorStatus    @default(TERSEDIA)
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  photos       MotorPhoto[]
  reviews      Review[]
  savedByUsers SavedMotor[]

  @@map("motors")
}

model MotorPhoto {
  id        String   @id @default(cuid())
  motorId   String
  url       String
  publicId  String // Cloudinary public ID
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@map("motor_photos")
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  motorId   String
  rating    Int // 1-5
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model SavedMotor {
  id        String   @id @default(cuid())
  userId    String
  motorId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  motor Motor @relation(fields: [motorId], references: [id], onDelete: Cascade)

  @@unique([userId, motorId])

  @@map("saved_motors")
}
